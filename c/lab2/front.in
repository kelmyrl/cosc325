10 PRINT "TIC TAC TOE"
20 PRINT "PLAYER 1 = X (1)"
30 PRINT "PLAYER 2 = O (2)"

40 LET A = 0
50 LET B = 0
60 LET C = 0
70 LET D = 0
80 LET E = 0
90 LET F = 0
100 LET G = 0
110 LET H = 0
120 LET I = 0

130 LET P = 1

140 PRINT "BOARD:"
150 PRINT A, B, C
160 PRINT D, E, F
170 PRINT G, H, I

180 PRINT "PLAYER", P, "ENTER POSITION (1-9)"
190 INPUT X

200 IF X = 1 THEN LET A = P
210 IF X = 2 THEN LET B = P
220 IF X = 3 THEN LET C = P
230 IF X = 4 THEN LET D = P
240 IF X = 5 THEN LET E = P
250 IF X = 6 THEN LET F = P
260 IF X = 7 THEN LET G = P
270 IF X = 8 THEN LET H = P
280 IF X = 9 THEN LET I = P

290 IF P = 1 THEN LET P = 2
300 IF P = 2 THEN LET P = 1

310 GOTO 140